[Unit]
Description=Excalibur fork node + miner
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace
UMask=0007
ExecStart=/usr/bin/python3 excalibur.py --network fork --max-blocks 100000 --workers 2 --p2p-host 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=append:/home/hatch/workspace/excalibur_fork.log
StandardError=append:/home/hatch/workspace/excalibur_fork.log

[Install]
WantedBy=multi-user.target
